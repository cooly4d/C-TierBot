# Secrets and local state: never bake these into the image. "**/" matches in every folder (a bare pattern in
# .dockerignore only matches at the top, unlike .gitignore).
**/.env
**/.env.*
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/*.db.part
**/data/
**/log/
**/backups/
**/queue_stats_*.json
**/queue_stats_*.json.tmp

# Local tooling and caches
.git/
.venv/
venv/
env/
__pycache__/
*.pyc
.agents/
.claude/
.codex/
.gemini/
.vscode/
.idea/

# Not needed at runtime
tests/
tools/
design-system/
*.md
.impeccable/
